{
  "name": "redeploy.soubiran.dev",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite --port 8787",
    "build": "vite build",
    "preview": "vite preview --port 8787",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts --strict-vars=false",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "dependencies": {
    "cloudflare": "^5.2.0",
    "@sentry/cloudflare": "^11.5.0",
    "evlog": "^2.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@cloudflare/vite-plugin": "^1.63.0",
    "eslint": "^10.11.0",
    "taze": "^19.17.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
